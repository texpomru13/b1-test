#!/bin/sh
# POSIX launcher for the Docker Compose services.
# Default local path needs ONLY Docker Engine/Desktop with Compose v2 — no host
# Python/uv/jq, no manual .env, no YAML editing. The profile resolver runs inside
# the pinned python base image; its decisions are written atomically to
# .runtime/resolved.env BEFORE any Compose interpolation.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PY_IMAGE="python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b"
# Compose project name (containers/volumes/network prefix). B1_PROJECT lets a second
# isolated copy (e.g. an evaluation stack) run next to the default one without
# touching its volumes; `-p` has the highest precedence over compose.yaml `name:`.
PROJECT=${B1_PROJECT:-b1-rag}
case "$PROJECT" in
    *[!a-z0-9_-]*|[!a-z0-9]*) printf 'error: B1_PROJECT must match [a-z0-9][a-z0-9_-]*\n' >&2; exit 2 ;;
esac
# Saved profile/lock are per project: the default keeps .runtime/, another
# B1_PROJECT gets its own .runtime-<project>/ (never overwrites the default's).
if [ "$PROJECT" = b1-rag ]; then RUNTIME_DIR="$ROOT/.runtime"; else RUNTIME_DIR="$ROOT/.runtime-$PROJECT"; fi
LOCK_DIR="$RUNTIME_DIR/launcher.lock"

fail() { printf 'error: %s\n' "$1" >&2; exit "${2:-1}"; }
stage() { printf '==> [%s] %s\n' "$1" "$2"; }

CMD=up; DRY_RUN=0; FORCE_BUILD=0; CLI_OFFLINE=0; JSON_OUT=0; OV_STRICT=0
OV_PROVIDER=""; OV_MODEL=""; OV_QUALITY=""; OV_EMB=""; OV_RR=""; OV_DEVICE=""; OV_PORT=""
while [ $# -gt 0 ]; do
    case "$1" in
    --port|--provider|--device|--quality|--model|--embedding-model|--reranker-model|--residency)
        [ $# -gt 1 ] && [ -n "$2" ] || fail "$1 requires a value" 2
        case "$2" in --*) fail "$1 requires a value" 2 ;; esac
        ;;
    esac
    case "$1" in
    up|doctor|status|logs|stop|down) CMD="$1" ;;
    --json) JSON_OUT=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --build) FORCE_BUILD=1 ;;
    --offline) CLI_OFFLINE=1 ;;
    --port) shift; OV_PORT=$1 ;;
    --provider) shift; OV_PROVIDER=$1 ;;
    --device) shift; OV_DEVICE=$1 ;;
    --quality) shift; OV_QUALITY=$1 ;;
    --model) shift; OV_MODEL=$1 ;;
    --embedding-model) shift; OV_EMB=$1 ;;
    --reranker-model) shift; OV_RR=$1 ;;
    --strict-profile) OV_STRICT=1 ;;
    --residency) shift; case "$1" in auto|resident-both) ;; *) fail "local-models requires resident-both" 2 ;; esac ;;
    --allow-slow) ;;  # legacy option: CPU inference is supported by default
    *) fail "unknown option '$1' (see README)" 2 ;;
    esac
    shift
done

command -v docker >/dev/null 2>&1 || fail "Install Docker Engine/Desktop with Compose v2." 10
docker info >/dev/null 2>&1 || fail "Start Docker Desktop or dockerd." 11
docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is required." 12
cd "$ROOT"

# The profile-specific file names are constants; all user paths stay quoted.
compose() {
    if [ "${B1_OFFLINE:-0}" = 1 ] && [ "${B1_SAVED_RUNTIME:-}" != host-ollama ]; then
        set -- -f compose.offline.yaml "$@"
    fi
    case "${B1_SAVED_RUNTIME:-}" in
        host-ollama) set -- -f compose.mac.yaml "$@" ;;
        dmr) set -- -f compose.dmr.yaml "$@" ;;
        openai-full) set -- -f compose.cloud.yaml -f compose.openai-full.yaml "$@" ;;
        openai|anthropic) set -- -f compose.cloud.yaml "$@" ;;
        container-ollama-gpu) set -- -f compose.gpu.yaml "$@" ;;
    esac
    docker compose -p "$PROJECT" --project-directory "$ROOT" -f compose.yaml "$@"
}

# Only the launcher-generated, shell-quoted profile is sourced. Compose parses
# the user's .env using its native syntax and environment precedence.
case "$CMD" in
    status|logs|stop|down)
        if [ -f "$RUNTIME_DIR/resolved.env" ]; then . "$RUNTIME_DIR/resolved.env"; fi
        ;;
esac
saved_value() {
    [ -f "$RUNTIME_DIR/resolved.env" ] || return 0
    sed -n "s/^export $1=//p" "$RUNTIME_DIR/resolved.env" | tr -d "'" | head -1
}

setting() {
    printf '%s\n' "$PROFILE_ENV" | sed -n "s/^$1=//p" | head -1
}
resolve_setting() {
    value=${1:-$(setting "$2")}
    case "$value" in auto) printf auto ;; "") saved_value "$3" ;; *) printf %s "$value" ;; esac
}
resolver() {
    if [ "$CLI_OFFLINE" = 1 ]; then pull=never; else pull=missing; fi
    docker run --pull="$pull" --rm -i -v "$ROOT/scripts/resolver.py:/resolver.py:ro" "$PY_IMAGE" python /resolver.py "$@"
}
with_options() {
    [ "$OV_STRICT" = 0 ] || set -- "$@" --strict-profile
    [ "$CLI_OFFLINE" = 0 ] || set -- "$@" --offline
    resolver "$@" "--provider=$OV_PROVIDER" "--model=$OV_MODEL" "--quality=$OV_QUALITY" \
        "--embedding-model=$OV_EMB" "--reranker-model=$OV_RR" "--device=$OV_DEVICE" \
        "--saved-encoder=$(saved_value B1_EMBEDDING_MODEL)" "--saved-runtime=$SAVED_RUNTIME" \
        "--port=$OV_PORT" "--seed-dir=$SEED_DIR"
}

ready_summary() {
    compose exec -T api python -c '
import json, urllib.request, urllib.error
try:
    r = urllib.request.urlopen("http://127.0.0.1:8000/health/ready", timeout=5)
    body = json.loads(r.read())
except urllib.error.HTTPError as e:
    body = json.loads(e.read())
print(json.dumps(body, ensure_ascii=False))
' 2>/dev/null || echo '{"status":"unknown"}'
}

api_container_health() {
    docker inspect --format '{{.State.Health.Status}}' "$PROJECT-api-1" 2>/dev/null || echo missing
}

service_state() {  # $1 service name -> running|exited(code)|missing
    docker inspect --format '{{.State.Status}} {{.State.ExitCode}}' "$PROJECT-$1-1" 2>/dev/null || echo "missing 0"
}

case "$CMD" in
    status) compose ps; printf 'readiness: %s\n' "$(ready_summary)"; exit 0 ;;
    logs) compose logs --tail=200; exit 0 ;;
    stop) compose stop; exit 0 ;;
    down) compose down; exit 0 ;;
esac

if [ "$DRY_RUN" = 0 ] && [ "$CMD" = up ]; then
    mkdir -p "$RUNTIME_DIR/empty-seed"
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        owner=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
        case "$owner" in ""|*[!0-9]*) fail "Existing launcher lock: $LOCK_DIR. Check for another ./run before removing it." 14 ;; esac
        if kill -0 "$owner" 2>/dev/null; then fail "Launcher PID $owner is active for this project." 14; fi
        fail "Stale launcher lock (PID $owner has exited). Remove $LOCK_DIR and retry." 14
    fi
    echo "$$" > "$LOCK_DIR/pid"
    trap 'rm -f "$LOCK_DIR/pid"; rmdir "$LOCK_DIR"' EXIT
    trap 'exit 130' INT TERM
fi

# Allowlist profile keys. Credentials never enter resolver arguments or output.
PROFILE_ENV=$(docker compose -p "$PROJECT" --project-directory "$ROOT" -f compose.yaml config --environment | awk '
    /^(LLM_PROVIDER|LLM_MODEL|QUALITY_PROFILE|RERANKER_MODEL|EMBEDDING_MODEL|DEVICE|PROFILE_STRICT|OFFLINE|B1_API_PORT)=/ {print}
    /^OPENAI_API_KEY=.+/ {print "HAS_OPENAI_KEY=1"}
    /^ANTHROPIC_API_KEY=.+/ {print "HAS_ANTHROPIC_KEY=1"}
')
SAVED_RUNTIME=$(saved_value B1_SAVED_RUNTIME)
[ -z "${OV_PROVIDER:-$(setting LLM_PROVIDER)}" ] || SAVED_RUNTIME=""
OV_PROVIDER=$(resolve_setting "$OV_PROVIDER" LLM_PROVIDER B1_SAVED_PROVIDER)
OV_QUALITY=$(resolve_setting "$OV_QUALITY" QUALITY_PROFILE B1_SAVED_QUALITY)
OV_MODEL=$(resolve_setting "$OV_MODEL" LLM_MODEL B1_SAVED_MODEL)
OV_RR=$(resolve_setting "$OV_RR" RERANKER_MODEL B1_SAVED_RERANKER)
OV_DEVICE=$(resolve_setting "$OV_DEVICE" DEVICE B1_SAVED_DEVICE)
OV_PORT=$(resolve_setting "$OV_PORT" B1_API_PORT B1_API_PORT)
OV_PORT=${OV_PORT:-8000}
OV_EMB=${OV_EMB:-$(setting EMBEDDING_MODEL)}
[ "$OV_MODEL" != auto ] || OV_MODEL=""
[ "$OV_EMB" != auto ] || OV_EMB=""
[ "$OV_RR" != auto ] || OV_RR=""
case "$(setting PROFILE_STRICT)" in 1|true|True|TRUE|yes) OV_STRICT=1 ;; esac
case "$(setting OFFLINE)" in 1|true|True|TRUE|yes) CLI_OFFLINE=1 ;; esac
case "$OV_PORT" in *[!0-9]*|'') fail "invalid --port" 2 ;; esac
[ "$OV_PORT" -ge 1 ] && [ "$OV_PORT" -le 65535 ] || fail "--port must be 1..65535" 2
SEED_DIR="$RUNTIME_DIR/empty-seed"
host_hf_cache=${HF_HOME:-"$HOME/.cache/huggingface"}
[ ! -d "$host_hf_cache/hub" ] || SEED_DIR="$host_hf_cache"
B1_HOST_OLLAMA_PORT=${B1_HOST_OLLAMA_PORT:-$(saved_value B1_HOST_OLLAMA_PORT)}
B1_HOST_OLLAMA_PORT=${B1_HOST_OLLAMA_PORT:-11434}
case "$B1_HOST_OLLAMA_PORT" in *[!0-9]*|'') fail "invalid B1_HOST_OLLAMA_PORT" 2 ;; esac
[ "$B1_HOST_OLLAMA_PORT" -ge 1 ] && [ "$B1_HOST_OLLAMA_PORT" -le 65535 ] || fail "invalid B1_HOST_OLLAMA_PORT" 2
export B1_HOST_OLLAMA_PORT
host_ollama_url="http://127.0.0.1:$B1_HOST_OLLAMA_PORT"

case "$OV_PROVIDER" in
    openai|openai-full) [ "$(setting HAS_OPENAI_KEY)" = 1 ] || fail "$OV_PROVIDER requires OPENAI_API_KEY" 3 ;;
    anthropic) [ "$(setting HAS_ANTHROPIC_KEY)" = 1 ] || fail "LLM_PROVIDER=anthropic requires ANTHROPIC_API_KEY" 3 ;;
esac
facts=$(sh "$ROOT/scripts/probe.sh")
if [ "$CMD" = doctor ] && [ "$JSON_OUT" = 1 ]; then
    printf '%s' "$facts" | with_options --format doctor
    exit $?
fi
res_status=0
RES=$(printf '%s' "$facts" | with_options --format result) || res_status=$?
[ -n "$RES" ] || fail "profile resolver could not run" 3
printf '%s' "$RES" | resolver --format summary
[ "$res_status" = 0 ] || fail "profile resolution failed" 3
[ "$CMD" != doctor ] || exit 0
if [ "$DRY_RUN" = 1 ]; then
    printf '%s' "$RES" | with_options --format env
    exit 0
fi

if command -v nc >/dev/null 2>&1 && nc -z 127.0.0.1 "$OV_PORT" 2>/dev/null; then
    docker port "$PROJECT-api-1" 8000/tcp 2>/dev/null | grep -Fqx "127.0.0.1:$OV_PORT" \
        || fail "Port $OV_PORT is in use. Select another with --port." 13
fi
printf '%s' "$RES" | with_options --format env > "$RUNTIME_DIR/resolved.env.tmp"
mv "$RUNTIME_DIR/resolved.env.tmp" "$RUNTIME_DIR/resolved.env"
printf '%s\n' "$RES" > "$RUNTIME_DIR/resolved-config.json.tmp"
mv "$RUNTIME_DIR/resolved-config.json.tmp" "$RUNTIME_DIR/resolved-config.json"
. "$RUNTIME_DIR/resolved.env"

if [ "$B1_SAVED_RUNTIME" = host-ollama ]; then
    stage download "ensuring host Ollama has $B1_LLM_MODEL (resumable pull)"
    if [ "$B1_OFFLINE" = 1 ]; then
        OLLAMA_HOST="$host_ollama_url" ollama show "$B1_LLM_MODEL" >/dev/null || fail "Missing local Ollama model $B1_LLM_MODEL" 4
    else
        OLLAMA_HOST="$host_ollama_url" ollama pull "$B1_LLM_MODEL" || fail "host ollama pull failed" 4
    fi
    # The QA graph needs JSON-schema structured output. Some host artifacts (e.g.
    # MLX builds picked by Ollama on Apple Silicon for bare tags) reject it, which
    # would otherwise surface only as 503s on every question.
    if command -v curl >/dev/null 2>&1; then
        stage warmup "checking structured output of $B1_LLM_MODEL on host Ollama"
        probe=$(curl -s --max-time 300 "$host_ollama_url/api/chat" -d "{\"model\":\"$B1_LLM_MODEL\",\"stream\":false,\"think\":false,\"messages\":[{\"role\":\"user\",\"content\":\"Return {\\\"ok\\\": true}\"}],\"format\":{\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"}},\"required\":[\"ok\"]},\"options\":{\"num_predict\":16,\"num_ctx\":2048}}" || true)
        case "$probe" in
        *'"error"'*) fail "host Ollama model $B1_LLM_MODEL cannot produce structured output: $probe
  Use a GGUF quantization tag (e.g. qwen3.5:9b-q4_K_M) via --model." 4 ;;
        '') printf '    - warning: structured-output probe got no response (continuing)\n' ;;
        esac
    fi
fi

stage images "building/starting services (first run may download many GiB)"
if [ "$B1_OFFLINE" = 1 ]; then
    compose up -d --no-build --pull never
elif [ "$FORCE_BUILD" = 1 ]; then
    compose up -d --build
else
    compose up -d
fi

if [ "$B1_SAVED_RUNTIME" != openai-full ]; then
    stage download "waiting for models-init (pinned snapshots into the hf_models volume)"
    i=0
    while :; do
        state=$(service_state models-init)
        case "$state" in
        "exited 0") break ;;
        "exited "*)
            compose logs models-init | tail -20
            fail "models-init failed (state: $state); see the asset list above — re-run ./run to resume" 4 ;;
        esac
        i=$((i + 1)); [ $i -gt 360 ] && fail "models-init did not finish in 30min; ./run logs" 4
        sleep 5
    done
fi

if [ "${B1_LLM_PROVIDER}" = "ollama" ] && [ "$B1_OLLAMA_BASE_URL" = "http://ollama:11434" ]; then
    stage download "waiting for ollama-init ($B1_LLM_MODEL into the ollama_models volume)"
    i=0
    while :; do
        state=$(service_state ollama-init)
        case "$state" in
        "exited 0") break ;;
        "exited "*) compose logs ollama-init | tail -10; fail "ollama-init failed" 4 ;;
        esac
        i=$((i + 1)); [ $i -gt 480 ] && fail "ollama-init did not finish in 40min" 4
        sleep 5
    done
fi

stage warmup "waiting for local-models (encoder + reranker load)"
i=0
until docker inspect --format '{{.State.Health.Status}}' "$PROJECT-local-models-1" 2>/dev/null | grep -qx healthy; do
    i=$((i + 1)); [ $i -gt 180 ] && { compose ps; fail "local-models not healthy in 15min; ./run logs" 20; }
    sleep 5
done

stage services "waiting for API liveness"
i=0
until [ "$(api_container_health)" = "healthy" ]; do
    case "$(service_state api)" in
        "exited "*) compose logs --tail=15 api; fail "API startup failed; see the error above" 20 ;;
    esac
    i=$((i + 1)); [ $i -gt 60 ] && { compose ps; fail "API did not become healthy; ./run logs" 20; }
    sleep 5
done

stage ready "waiting for full readiness"
i=0
while :; do
    summary=$(ready_summary)
    case "$summary" in *'"status": "ready"'*|*'"status":"ready"'*) break ;; esac
    i=$((i + 1))
    if [ $i -gt "${RUN_READY_TIMEOUT_POLLS:-120}" ]; then
        printf '==> readiness NOT reached: %s\n' "$summary"
        fail "readiness timeout — components above show the real state; ./run status" 21
    fi
    sleep 5
done

printf '\nReady. Resolved stack (candidate preset, reasons above):\n'
printf '  provider=%s model=%s\n' "$B1_LLM_PROVIDER" "$B1_LLM_MODEL"
printf '  encoder=%s@%s\n' "$B1_EMBEDDING_MODEL" "$(printf '%s' "$B1_EMBEDDING_REVISION" | cut -c1-8)"
printf '  reranker=%s (%s)\n' "$B1_RERANKER_MODEL" "$B1_RERANKER_ADAPTER"
[ "$B1_QUALITY_DEGRADED" = "1" ] && printf '  !! QUALITY DEGRADED: %s\n' "$B1_QUALITY_DEGRADED_REASON"
printf '  API: http://127.0.0.1:%s  (docs: /docs, ready: /health/ready)\n' "${B1_API_PORT:-8000}"
printf '  Logs: ./run logs   Status: ./run status   Stop: ./run stop   Down (keep data): ./run down\n'
