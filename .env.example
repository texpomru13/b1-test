# Optional overrides. The default local run needs NO .env at all.
# Copy to .env and uncomment what you need. Works the same for `./run` and for
# raw `docker compose up`: compose.yaml forwards these variables to the
# containers, and the same names may be set in the shell instead.
# Unknown keys are rejected when the app is started from the host
# (Settings has extra=forbid). Full contract: app/config/settings.py.

# --- Models and profile (resolved by ./run; CLI flags take precedence) ---
# With raw `docker compose up` set B1_LLM_PROVIDER / B1_LLM_MODEL /
# B1_EMBEDDING_MODEL(+_REVISION) / B1_RERANKER_MODEL(+_REVISION, +_ADAPTER) instead.
#LLM_PROVIDER=ollama            # auto|ollama|dmr|openai|anthropic (a key alone NEVER enables cloud)
#LLM_MODEL=auto                 # e.g. qwen3.6:27b-q4_K_M (ollama) / ai/qwen3.6:27B (dmr)
#EMBEDDING_MODEL=auto           # ai-sage/Giga-Embeddings-instruct | ai-sage/Giga-Embeddings-instruct-480M-0826
#RERANKER_MODEL=auto            # Qwen/Qwen3-Reranker-8B | BAAI/bge-reranker-v2-m3
#QUALITY_PROFILE=quality        # quality|quality-compact|balanced|low-memory
#PROFILE_STRICT=false           # true: fail instead of falling back to a smaller profile
#DEVICE=auto                    # auto|cpu|metal|nvidia
#OFFLINE=false                  # true: same as ./run --offline
#EMBEDDING_BATCH_SIZE=4         # encode batch inside the local-models service
#RERANKER_BATCH_SIZE=2          # scoring batch inside the local-models service

# --- Cloud keys and LLM timeouts ---
#OPENAI_API_KEY=                # used only with an explicit openai provider
#ANTHROPIC_API_KEY=             # used only with an explicit anthropic provider
#DMR_BASE_URL=http://model-runner.docker.internal/engines/v1   # compose: B1_DMR_BASE_URL
#LLM_READ_TIMEOUT_S=300         # default depends on the runtime (CPU: 1200)
#QA_DEADLINE_S=900              # default depends on the runtime (CPU: 3600)

# --- Hybrid search and reranking (quality defaults 60/60/60/8) ---
#FUSION_METHOD=rrf              # rrf|dbsf — server-side fusion in Qdrant
#DENSE_TOP_K=60                 # candidates of the dense branch
#SPARSE_TOP_K=60                # candidates of the BM25 branch
#RERANK_INPUT_K=60              # candidates passed to the reranker
#CONTEXT_TOP_K=8                # top reranked chunks passed to the LLM

# --- Chunking, BM25, context budget ---
#CHUNK_TOKENS=450
#CHUNK_OVERLAP_TOKENS=64
#BM25_LANGUAGE=russian
#BM25_AVG_LEN=256
#CONTEXT_BUDGET_TOKENS=6000
#LOCAL_CONTEXT_TOKENS=16384
#LLM_MAX_OUTPUT_TOKENS=2048
#LLM_REASONING_BUDGET_TOKENS=4096
# Ollama only: auto (model default) | on | off — reasoning ("thinking") mode
#LLM_THINKING=auto

# --- Connections (defaults target the bundled compose services) ---
#QDRANT_URL=http://qdrant:6333
#QDRANT_COLLECTION=document_chunks
#REDIS_URL=redis://redis:6379/0
#CELERY_BROKER_URL=redis://redis:6379/1
#CELERY_RESULT_BACKEND=redis://redis:6379/2
#LOCAL_MODELS_URL=http://local-models:8081
#LOCAL_MODELS_TIMEOUT_S=300
#DOCUMENTS_DIR=/data/documents  # host runs only; fixed inside the containers

# --- Limits ---
#MAX_FILE_MB=25
#MAX_PAGES=100
#MAX_QUESTION_CHARS=4000
#MAX_CONCURRENT_QA=1

# --- Grounding and reliability ---
#MAX_REPAIR_ATTEMPTS=1
#MAX_LLM_CALLS_PER_QUESTION=4
#LLM_MAX_ATTEMPTS=2             # transport attempts per LLM call
#QDRANT_MAX_ATTEMPTS=3          # attempts per Qdrant operation (indexing and search)
#JOB_MAX_ATTEMPTS=3
#RECONCILE_INTERVAL_S=30
#FAILED_SOURCE_TTL_S=604800

# --- Evaluation (paid calls are OFF by default; enabling REQUIRES a cost cap) ---
#ALLOW_PAID_EVAL=false
#EVAL_MAX_COST_USD=
